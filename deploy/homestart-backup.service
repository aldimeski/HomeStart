[Unit]
Description=HomeStart database backup
After=local-fs.target

[Service]
Type=oneshot
User=homestart
Group=homestart
Environment=HOMESTART_HOME=/opt/homestart
WorkingDirectory=/opt/homestart/backend
ExecStart=/opt/homestart/venv/bin/python -m homestart.backup
# Backups are only taken, never restored, by this unit: it reads the database folder and writes the backups.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homestart /var/backups/homestart
